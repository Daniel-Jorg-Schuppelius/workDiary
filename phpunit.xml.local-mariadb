<?xml version="1.0" encoding="UTF-8"?>
<!-- Lokale Konfiguration (nicht eingecheckt): Tests laufen gegen den lokalen
     MariaDB-Server statt SQLite - naeher an Produktion und dank Fingerprint-
     Wiederverwendung (tests/Support/PersistedTestDatabase.php) ohne den
     Schema-Dump-Load pro Lauf. Frischen Aufbau erzwingen: TEST_DB_FRESH=1
     oder php artisan test - -recreate-databases. CI nutzt phpunit.xml.dist. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Deckel gegen Speicher-Amok einzelner Tests: die CLI läuft sonst mit memory_limit=-1 (WSL2-Absturz bei 42 GB). -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <!-- Kein Dateilog im Testlauf: debug-Ausgaben der Toolkits füllten storage/logs/laravel.log auf 784 MB. -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_INSTALLED" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="workdiary_testing"/>
        <env name="DB_USERNAME" value="schuppeliusd"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_SOCKET" value="/var/run/mysqld/mysqld.sock"/>
        <env name="DB_URL" value=""/>
        <env name="LEGACY_DB_DATABASE" value=""/>
        <env name="LEGACY_DB_HOST" value=""/>
        <env name="LEGACY_DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
