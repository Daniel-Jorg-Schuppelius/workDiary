{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        // Prüft die bestehenden .js-Module über JSDoc, ohne Umbenennung.
        // Eine spätere .ts-Portierung bleibt damit ein mechanischer Schritt.
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        // Neuer Code ist strict-rein; die Altbefunde stehen in
        // typecheck-baseline.json und werden dort abgebaut.
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "types": []
    }
}
