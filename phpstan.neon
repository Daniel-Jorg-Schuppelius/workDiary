includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - app
    excludePaths:
        - app/Legacy/Models/*
        # Plugin-eigene Config-Dateien sind reine config()-Rückgaben (wie config/,
        # das ebenfalls nicht analysiert wird) — env() ist hier zulässig.
        - app/Plugins/*/config.php
