<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|docs|lang|resources|routes|scripts|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|phpstan(-baseline)?\.neon|pint\.json|vite\.config\.js)$ - [F,L]

    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ /$1 [L,R=301]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Punktdateien: `^\.$` traf nur eine Datei mit dem Namen "." — .env.backup,
# .htpasswd und Konsorten blieben offen (Sicherheitsaudit 2026-09-13).
# `.well-known` bleibt offen: Gibt es das Verzeichnis nicht, hält Apache den
# Pfadteil für den Dateinamen — ohne Ausnahme liefert security.txt 403.
<FilesMatch "^\.(?!well-known$)">
    Require all denied
</FilesMatch>

<FilesMatch "^(?:composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml(?:\.dist)?|phpstan(?:-baseline)?\.neon|pint\.json|vite\.config\.js|artisan)$">
    Require all denied
</FilesMatch>

# Punktverzeichnisse (.git, .github) sperrt die RewriteRule oben.
# KEIN <Directory>/<DirectoryMatch>/<Location> hier: in einer .htaccess
# verboten, Apache liefert dann für JEDE Anfrage 500 (Ausfall 2026-09-14).
