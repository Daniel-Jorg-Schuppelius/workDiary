APP_NAME=WorkDiary
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

LEGACY_DB_DRIVER=mysql
LEGACY_DB_URL=
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_SOCKET=
LEGACY_DB_CHARSET=latin1
LEGACY_DB_COLLATION=latin1_german2_ci
LEGACY_DB_PREFIX=
LEGACY_MYSQL_ATTR_SSL_CA=
LEGACY_DB_ENCRYPT=no
LEGACY_DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# API-Token-Ablauf in Minuten (leer = kein Ablauf). Für höhere Sicherheit z. B. 43200 (30 Tage).
SANCTUM_TOKEN_EXPIRATION=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
LEGACY_WRITE_ENABLED=false
MAIL_NOTIFICATIONS_ENABLED=false

WORK_HOURS_CORE_START=08:00
WORK_HOURS_CORE_END=16:00
WORK_HOURS_CORE_DAYS=1,2,3,4,5

WORK_HOURS_EXTENDED_START=06:00
WORK_HOURS_EXTENDED_END=19:00
WORK_HOURS_EXTENDED_DAYS=1,2,3,4,5

# ── Stundenzettel / Material / Gleitzeit ─────────────────────────────
TIMESHEET_DEFAULT_WEEKLY_MINUTES=2400
TIMESHEET_DEFAULT_DAILY_MINUTES=480
TIMESHEET_DEFAULT_WORKING_DAYS=1,2,3,4,5
TIMESHEET_CORE_START=09:00
TIMESHEET_CORE_END=15:00
TIMESHEET_FRAME_START=06:00
TIMESHEET_FRAME_END=20:00
TIMESHEET_BREAK_AFTER_MINUTES=360
TIMESHEET_MIN_BREAK_MINUTES=30
TIMESHEET_SIG_MAX_KB=1000
TIMESHEET_MAGIC_MINUTES=1440
TIMESHEET_PDF_DISK=local
LEXOFFICE_API_KEY=
