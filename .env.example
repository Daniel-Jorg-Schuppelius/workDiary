APP_NAME=WorkDiary
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

LEGACY_DB_DRIVER=mysql
LEGACY_DB_URL=
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_SOCKET=
LEGACY_DB_CHARSET=latin1
LEGACY_DB_COLLATION=latin1_german2_ci
LEGACY_DB_PREFIX=
LEGACY_MYSQL_ATTR_SSL_CA=
LEGACY_DB_ENCRYPT=no
LEGACY_DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# API-Token-Ablauf in Minuten (leer = kein Ablauf). Für höhere Sicherheit z. B. 43200 (30 Tage).
SANCTUM_TOKEN_EXPIRATION=

# CSP Stufe 1 (Default AN seit 2026-07-14): Pro-Request-Nonce statt
# 'unsafe-inline' in script-src. Bei CSP-Konsolenfehlern (nicht-nonctes
# Inline-Script) auf false zurückschalten und die Stelle auf @cspNonce umstellen
# (Checkliste: WorkDiary-Architecture/chronik/audits/hardening-2026-06.md).
CSP_SCRIPT_NONCE=true

# CSP Stufe 2 (Default AN seit 2026-07-14): Alpine im @alpinejs/csp-Build →
# 'unsafe-eval' entfällt aus script-src. Steuert AUCH den Vite-Build-Switch
# (vite.config.js): nach JEDEM Umschalten zwingend `npm run build`, sonst passt
# der CSP-Header nicht zum Bundle.
ALPINE_CSP_BUILD=true

# CVD-Meldekanal /.well-known/security.txt (RFC 9116, CRA-Welle 1): E-Mail
# oder URL für Schwachstellenmeldungen. Leer = Endpunkt liefert 404.
# Optional: SECURITY_TXT_POLICY (CVD-Policy-URL), SECURITY_TXT_LANGUAGES,
# SECURITY_TXT_EXPIRES_DAYS (Default 180).
SECURITY_TXT_CONTACT=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Graph-Versand mit SMTP-Rückfallebene (Feature 102, empfohlen ab Ende 2026 —
# SMTP-Basic-Auth-Abschaltung): MAIL_MAILER=failover + Kette wie unten.
# MAIL_FAILOVER_MAILERS=msgraph,smtp,log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
LEGACY_WRITE_ENABLED=false

WORK_HOURS_CORE_START=08:00
WORK_HOURS_CORE_END=16:00
WORK_HOURS_CORE_DAYS=1,2,3,4,5

WORK_HOURS_EXTENDED_START=06:00
WORK_HOURS_EXTENDED_END=19:00
WORK_HOURS_EXTENDED_DAYS=1,2,3,4,5

# ── Stundenzettel / Material / Gleitzeit ─────────────────────────────
TIMESHEET_DEFAULT_WEEKLY_MINUTES=2400
TIMESHEET_DEFAULT_DAILY_MINUTES=480
TIMESHEET_DEFAULT_WORKING_DAYS=1,2,3,4,5
TIMESHEET_CORE_START=09:00
TIMESHEET_CORE_END=15:00
TIMESHEET_FRAME_START=06:00
TIMESHEET_FRAME_END=20:00
TIMESHEET_BREAK_AFTER=360
TIMESHEET_BREAK_MIN=30
TIMESHEET_SIGNATURE_MAX_KB=1000
TIMESHEET_MAGIC_MINUTES=1440
LEXOFFICE_API_KEY=

# Microsoft 365 (Msgraph-Plugin) — Instanz-App-Registrierung in Entra ID.
# Organisationen können im Plugin-Dialog eine eigene App hinterlegen (Variante B);
# ohne Overlay gilt diese Instanz-App. Multi-Tenant-Betrieb ("Mit Microsoft
# verbinden" ohne kundenseitige App-Registrierung): MSGRAPH_TENANT=common +
# publisher-verifizierte Entra-App — Konzept/Betriebsschritte:
# WorkDiary-Architecture/betrieb/ms365-multitenant-app.md. Redirect-URIs zeigt
# das Msgraph-Admin-Panel; Endpunkte/Scopes sind bewusst nur per config änderbar.
MSGRAPH_ENABLED=false
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_TENANT=common

# Routing / Touren (Nominatim Geocoding + OSRM Routing, optional selbst gehostet)
ROUTING_NOMINATIM_URL=http://localhost:8080
ROUTING_NOMINATIM_UA="workDiary/${APP_URL}"
ROUTING_NOMINATIM_EMAIL=admin@example.com
ROUTING_NOMINATIM_RATE=1
ROUTING_NOMINATIM_TIMEOUT=8
ROUTING_OSRM_URL=http://localhost:5000
ROUTING_OSRM_PROFILE=driving
ROUTING_OSRM_TIMEOUT=10
ROUTING_VROOM_URL=
ROUTING_VROOM_TIMEOUT=60
ROUTING_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ROUTING_TILES_MAX_ZOOM=19
ROUTING_CACHE_TTL_DAYS=365

WHISTLEBLOWING_KEY=
WHISTLEBLOWING_LOOKUP_KEY=

# Backup & Restore — Details: docs/backup-restore.md
# Heartbeat-Token des externen Backup-Skripts; erzeugen/rotieren mit
# `scripts/artisan.sh workdiary:backup:rotate-token` (leer = Endpoint deaktiviert).
BACKUP_HEARTBEAT_TOKEN=
# Frische-Schwelle der Statusseite je Quelle (Stunden).
BACKUP_HEARTBEAT_FRESHNESS_HOURS=26

# Verschlüsselte Cloud-Backupziele (Feature 017, Phase 32)
# Master-Key: 32 Byte base64 (php -r "echo base64_encode(random_bytes(32));")
# OFFLINE sichern — Verlust ohne Recovery-Key macht alle Backups wertlos.
BACKUP_MASTER_KEY=
# Optionaler Recovery-Public-Key (crypto_box, base64); ohne ihn warnt die UI dauerhaft.
BACKUP_RECOVERY_PUBLIC_KEY=

# --- Sicherheit: Integrität + Angriffserkennung (Features 095/096) ---
# Reverse-Proxy-IPs/CIDRs (Komma-Liste) oder '*'; ohne diese Angabe ist
# Request::ip() hinter einem Proxy die Proxy-IP (fail2ban/Limits/Geo!).
TRUSTED_PROXIES=
# Täglicher Quelltext-Integritätslauf (integrity:verify).
INTEGRITY_CHECK_ENABLED=true
# Realtime-Wächter (integrity:watch, MVP-453): Sammelfenster in Sekunden nach
# der letzten Änderung, bevor ein Verify ausgelöst wird. Braucht ext-inotify.
INTEGRITY_WATCH_DEBOUNCE=30
# Security-Log zusätzlich an Syslog spiegeln (SIEM-Anbindung).
SECURITY_LOG_SYSLOG=false
# Strukturierter SIEM-Export (MVP-452): off | cef | json; Ziel file (storage/logs/security-siem.log)
# oder syslog (UDP an SECURITY_SIEM_HOST:SECURITY_SIEM_PORT).
SECURITY_SIEM_FORMAT=off
SECURITY_SIEM_TARGET=file
SECURITY_SIEM_HOST=127.0.0.1
SECURITY_SIEM_PORT=514
# Optionale IP-Allowlist (IPs/CIDRs) für Plattform-Admins im Adminbereich.
PLATFORM_ADMIN_IP_ALLOWLIST=
# Lokale GeoIP-Datenbank (.mmdb, MaxMind GeoLite2 oder DB-IP City Lite) für
# Sitzungs-Standortanzeige (085) und Impossible-Travel (MVP-449). Leer =
# beide Funktionen ruhen still. Bezug/Aktualisierung: docs/geoip.md
# (DB-IP Lite ist CC BY 4.0 — Attribution erforderlich).
GEOIP_DATABASE=
GEOIP_LOCALE=de
# Monatlicher Abruf der DB-IP-Lite-Datenbank nach GEOIP_DATABASE (security:geoip-update)
GEOIP_AUTO_UPDATE=false
# GEOIP_UPDATE_URL=https://download.db-ip.com/free/dbip-city-lite-{month}.mmdb.gz

# --- Betrieb: Logging, Scheduler, Queue (Vollscan 2026-08-23, J13/J15) ---
# Produktion: LOG_STACK=daily + LOG_LEVEL=info (oben), sonst wächst eine
# einzige laravel.log im debug-Level ohne Rotation.
# Aufbewahrung der täglichen Logdateien in Tagen.
LOG_DAILY_DAYS=14
# Log-Kanal für die Toolkits (php-error-toolkit-Bridge); leer = Laravel-Default.
ERROR_TOOLKIT_LOG_CHANNEL=
# Aufbewahrung der Scheduler-Laufnachweise (scheduled_job_runs) in Tagen.
SCHEDULER_RUNS_RETENTION_DAYS=30
# Muss über dem größten Job-Timeout (600 s) liegen, sonst laufen Jobs doppelt.
DB_QUEUE_RETRY_AFTER=630
# Aufgelöste Integrations-Inbox-Einträge nach n Tagen löschen (integration:purge-inbox).
INTEGRATION_INBOX_RETENTION_DAYS=90
# Zustell-/Outbox-Protokolle: erfolgreiche nach n, gescheiterte nach m Tagen löschen.
INTEGRATION_DELIVERY_RETENTION_DAYS=90
INTEGRATION_FAILED_RETENTION_DAYS=180
# Nicht konvertierte Leads n Monate nach dem letzten Kontakt anonymisieren.
SALES_LEAD_RETENTION_MONTHS=6
# Umfrage-Ermüdungsschutz: keine zweite Einladung innerhalb von n Tagen.
SURVEYS_FATIGUE_DAYS=90
# Kundenrundschreiben: Empfänger je Queue-Lauf (Versand läuft in Batches).
CIRCULAR_BATCH_SIZE=200

# --- Mehrmandantenbetrieb (Sicherheitsscan 2026-08) -------------------------
# Im SaaS-Betrieb beide auf false setzen. Im Einzelplatzbetrieb bleiben sie an:
# dort steht in dieser Datei der eigene Schlüssel, und der eigene Server steht
# tatsächlich im eigenen Netz.
#
# false: Plugin-Geheimnisse fallen NICHT mehr auf diese Datei zurück — ein
#        Mandant ohne eigene Zugangsdaten arbeitet sonst über die des Betreibers.
#
# Vorgabe seit dem Sicherheitsaudit 2026-09-13: geschlossen, auch im Code.
# Eine Bestandsinstallation, deren Plugins auf diese Datei zurückfallen,
# verliert die Anbindung, bis die Organisation eigene Zugangsdaten hinterlegt
# oder hier ausdrücklich `true` steht.
PLUGINS_ALLOW_ENV_SECRET_FALLBACK=false
# false: Der Org-Admin kann die SSRF-Leitplanke nicht mehr je Anbindung
#        abschalten (CardDAV, CalDAV, WebDAV, Zammad, JTL-Wawi, GitLab,
#        Kimai, OpenProject, KI-Verbindungen, SSO).
PLUGINS_ALLOW_PRIVATE_NETWORK_OPT_IN=true

# Zeitzone, in der der Zeitplan (dailyAt/Cron der Job-Registry) ausgewertet wird
SCHEDULE_TIMEZONE=Europe/Berlin
# Betriebsfenster des Servers (HH:MM in SCHEDULE_TIMEZONE), z. B. 08:00 / 00:00 für
# nächtliche Abschaltung: Tageszeit-Jobs außerhalb laufen zu Fensterbeginn.
# Leer = rund um die Uhr. Auch unter Admin → Einstellungen übersteuerbar.
SCHEDULER_OPERATING_WINDOW_START=
SCHEDULER_OPERATING_WINDOW_END=

# Lieferantenkatalog per FTP ohne TLS zulassen (Vorgabe: false).
# Ohne TLS gehen Benutzername und Passwort im Klartext ueber die Leitung.
PROCUREMENT_FTP_ALLOW_PLAINTEXT=false

# Zusaetzliche Herkuenfte fuer Cross-Origin-Aufrufe der REST-Schnittstelle,
# kommagetrennt. Leer = nur APP_URL. Server-zu-Server und mobile Anwendungen
# senden keinen Origin und brauchen hier nichts (Sicherheitsaudit 2026-09-13).
CORS_ALLOWED_ORIGINS=

# SCORM-Kursinhalte von eigenem Host (Subdomain oder eigene Domain), damit fremder
# Kurscode nicht im Ursprung der Anwendung läuft. Leer = gleicher Ursprung
# (Systemcheck warnt). Voraussetzung: DNS, TLS und vHost-Alias auf dasselbe Docroot.
# Setzt zugleich das Präfix __Host- am Sitzungscookie (alle Sitzungen enden einmalig).
LEARNING_SCORM_CONTENT_URL=

# cmi5: So lange (Sekunden) nimmt das LRS nach dem Start einer AU Statements an.
LEARNING_CMI5_SESSION_TTL=28800

# ══════════════════════════════════════════════════════════════════
# Weitere Stellschrauben (nachgetragen 2026-09-17, MVP-796, Befund C1-13)
#
# Alle folgenden Schluessel werden von config/ gelesen, standen aber in
# keiner Vorlage — Betreiber konnten sie nicht kennen. Sie sind hier
# auskommentiert mit ihrer Vorgabe aufgefuehrt: Auskommentiert gilt die
# Vorgabe, Einkommentieren uebersteuert sie.
# ══════════════════════════════════════════════════════════════════

