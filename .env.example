# BACKUP_RESTORE_TEST_INTERVAL_DAYS=30
# BACKUP_RESTORE_TEST_OVERDUE_DAYS=180
# BACKUP_SIZE_DROP_RATIO=0.5

# ── Sicherung – Ziele und Werkzeuge (config/backup_targets.php) ───────────────
