<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Strip an accidental /public/ prefix (e.g. when DocumentRoot already
    # points at public/ and a link was generated with /public/ in it).
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ /$1 [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Gebaute Assets tragen den Inhalts-Hash im Dateinamen (Vite): ein Jahr
# gültig und unveränderlich, der Browser fragt nicht mehr nach. Ohne diese
# Kopfzeile rät er die Frische aus Last-Modified und prüft nach einem Deploy
# bei fast jedem Seitenaufruf jede Datei neu. Fehlende Dateien landen beim
# Front-Controller (anderer Pfad) und bekommen die Kopfzeile nicht.
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#/build/assets/[^/]+$#"
</IfModule>
