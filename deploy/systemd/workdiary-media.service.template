# WorkDiary Medien-Worker (Feature 150) — von scripts/install-system.sh gerendert.
# Platzhalter: __APP_DIR__, __PHP_BIN__, __RUN_USER__
#
# Eigene Verbindung "media" (retry_after 2 h): Textindex der Dokumente,
# Transcoding, Untertitel und lange Importe rechnen bis zu einer Stunde; auf
# der Standardverbindung stellte der Treiber sie nach 630 s ein zweites Mal zu.
# --tries=1: ein abgebrochener Medienlauf wird nicht blind wiederholt.
# Logs: journalctl -u workdiary-media

[Unit]
Description=WorkDiary Medien-Worker (QUEUE_CONNECTION=database, Warteschlange media)
After=network.target mysql.service mariadb.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__PHP_BIN__ __APP_DIR__/artisan queue:work media --queue=media --tries=1 --timeout=3600 --sleep=5 --max-time=7200
Restart=always
RestartSec=5
TimeoutStopSec=3660
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
