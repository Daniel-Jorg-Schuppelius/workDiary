# WorkDiary Queue-Worker (MVP-454) — von scripts/install-system.sh gerendert.
# Platzhalter: __APP_DIR__, __PHP_BIN__, __RUN_USER__
#
# --max-time=3600: der Worker beendet sich stündlich selbst und wird von
# systemd frisch gestartet — so greifen Deploys ohne manuellen Restart.
# Logs: journalctl -u workdiary-queue

[Unit]
Description=WorkDiary Queue-Worker (QUEUE_CONNECTION=database)
After=network.target mysql.service mariadb.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__PHP_BIN__ __APP_DIR__/artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5
# Laufende Jobs beim Stop sauber zu Ende bringen lassen.
# Muss über dem größten Job-Timeout (600 s, ProcessCsvImportJob) liegen — sonst
# killt systemd beim Stop einen laufenden Import und die Queue wiederholt ihn
# nach retry_after (Vollscan 2026-08-23, J7).
TimeoutStopSec=660
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
