# WorkDiary Cron (MVP-454) — von scripts/install-system.sh nach
# /etc/cron.d/workdiary (bzw. /etc/cron.d/workdiary-<instanz>) gerendert.
# Platzhalter: __APP_DIR__, __PHP_BIN__, __RUN_USER__, __BACKUP_MIN__,
#              __BACKUP_HOUR__, __BACKUP_CONF__, __BACKUP_LOG__
#
# schedule:run ist der Herzschlag der App (Scheduler-Registry, Feature 067) —
# ohne diese Zeile läuft KEIN wiederkehrender Job. Das Backup läuft als root
# (liest .env, schreibt /var/backups) und muss in die Betriebszeit des
# Servers fallen (kein Nachhol-Verhalten).

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * * __RUN_USER__ __PHP_BIN__ __APP_DIR__/artisan schedule:run >> /dev/null 2>&1
# Das Backup laeuft als root. Es startet deshalb aus einer root-eigenen Kopie
# unter /usr/local/sbin und NICHT aus dem Anwendungsverzeichnis: dort darf der
# Deploy-/Webbenutzer schreiben, und ein Cron-Eintrag, der als root ein vom
# Webbenutzer beschreibbares Skript ausfuehrt, ist eine Rechteausweitung
# (Sicherheitsaudit 2026-09-13). scripts/install-system.sh legt die Kopie an
# und frischt sie bei jedem Lauf auf.
__BACKUP_MIN__ __BACKUP_HOUR__ * * * root BACKUP_CONF=__BACKUP_CONF__ __BACKUP_BIN__ >> __BACKUP_LOG__ 2>&1
