# WorkDiary Cron (MVP-454) — von scripts/install-system.sh nach
# /etc/cron.d/workdiary gerendert.
# Platzhalter: __APP_DIR__, __PHP_BIN__, __RUN_USER__, __BACKUP_MIN__, __BACKUP_HOUR__
#
# schedule:run ist der Herzschlag der App (Scheduler-Registry, Feature 067) —
# ohne diese Zeile läuft KEIN wiederkehrender Job. Das Backup läuft als root
# (liest .env, schreibt /var/backups) und muss in die Betriebszeit des
# Servers fallen (kein Nachhol-Verhalten).

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * * __RUN_USER__ __PHP_BIN__ __APP_DIR__/artisan schedule:run >> /dev/null 2>&1
__BACKUP_MIN__ __BACKUP_HOUR__ * * * root __APP_DIR__/scripts/backup.sh >> /var/log/workdiary-backup.log 2>&1
