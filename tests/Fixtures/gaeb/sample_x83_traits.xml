<?xml version="1.0" encoding="UTF-8"?>
<!--
  Feature 108, MVP-565: Positionsmerkmale nach dem Vorbild der BVBS-Prüfdatei —
  Bedarfsposition mit Gesamtbetrag (Provis), Grund- und Alternativposition einer
  ALN-Gruppe, Zuschlagsposition als eigenes Element MarkupItem, Hinweistext als
  Remark, eine Leitbeschreibung mit zwei Unterbeschreibungen und eine Position
  mit zwei Textergänzungen des Bieters (MVP-568).
-->
<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.3">
  <GAEBInfo>
    <Version>3.3</Version>
    <VersDate>2021-05</VersDate>
    <Date>2026-08-16</Date>
    <ProgSystem>WorkDiary Test</ProgSystem>
  </GAEBInfo>
  <PrjInfo>
    <NamePrj>Positionsmerkmale Prüffall</NamePrj>
    <Cur>EUR</Cur>
  </PrjInfo>
  <Award>
    <DP>83</DP>
    <Cur>EUR</Cur>
    <BoQ ID="BOQ-TRAITS">
      <BoQInfo>
        <Name>1</Name>
        <NoUPComps>4</NoUPComps>
        <LblUPComp1 Type="Wages">Lohn</LblUPComp1>
        <LblUPComp2 Type="Material">Stoffe</LblUPComp2>
        <LblUPComp3 Type="Equipment">Geräte</LblUPComp3>
        <LblUPComp4 Type="Other">Sonstiges</LblUPComp4>
      </BoQInfo>
      <BoQBody>
        <BoQCtgy RNoPart="001" ID="C-001">
          <LblTx><p><span>Erdarbeiten</span></p></LblTx>
          <BoQBody>
            <Itemlist>
              <Item RNoPart="0010" ID="I-STD">
                <UPBkdn>Yes</UPBkdn>
                <Qty>450.000</Qty>
                <QU>m3</QU>
                <UP>20.000</UP>
                <UPComp1>12.000</UPComp1>
                <UPComp2>5.000</UPComp2>
                <UPComp3>2.000</UPComp3>
                <UPComp4>1.000</UPComp4>
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Boden lösen</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item RNoPart="0010" RNoIndex="1" ID="I-PROVIS">
                <Provis>WithTotal</Provis>
                <Qty>1.000</Qty>
                <QU>Psch</QU>
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Wasserhaltung betreiben</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item RNoPart="0020" ID="I-BASE">
                <ALNGroupNo>1</ALNGroupNo>
                <ALNSerNo>0</ALNSerNo>
                <Qty>1245.000</Qty>
                <QU>m2</QU>
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Betonpflaster grau (Grundausführung)</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item RNoPart="0030" ID="I-ALT">
                <ALNGroupNo>1</ALNGroupNo>
                <ALNSerNo>1</ALNSerNo>
                <Qty>1245.000</Qty>
                <QU>m2</QU>
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Betonpflaster anthrazit (Alternative)</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <MarkupItem RNoPart="0040" ID="I-MARKUP">
                <MarkupType>AllInCat</MarkupType>
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Zuschlag auf alle vorstehenden Positionen</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </MarkupItem>
              <Item RNoPart="0050" ID="I-SUMDESCR">
                <Qty>1.000</Qty>
                <QU>Stck</QU>
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Türblatt (Leitbeschreibung)</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
                <SumDescr>Yes</SumDescr>
                <SubDescr>
                  <SubDNo>01</SubDNo>
                  <QtySpec>Yes</QtySpec>
                  <Qty>2.000</Qty>
                  <QU>Stck</QU>
                </SubDescr>
                <SubDescr>
                  <SubDNo>02</SubDNo>
                  <QtySpec>Yes</QtySpec>
                  <Qty>3.000</Qty>
                  <QU>Stck</QU>
                </SubDescr>
              </Item>
              <Item RNoPart="0070" ID="I-COMPL">
                <Qty>8.000</Qty>
                <QU>Stck</QU>
                <Description>
                  <CompleteText>
                    <ComplTSB>Yes</ComplTSB>
                    <DetailTxt>
                      <Text><p><span>Fenster in hochwertiger Ausfertigung mit einer</span></p></Text>
                      <TextComplement MarkLbl="60" Kind="Bidder">
                        <ComplCaption><span>Breite von</span></ComplCaption>
                        <ComplBody><span>...........</span></ComplBody>
                        <ComplTail><span>cm.</span></ComplTail>
                      </TextComplement>
                      <Text><p><span>und einer</span></p></Text>
                      <TextComplement MarkLbl="61" Kind="Bidder">
                        <ComplCaption><span>Höhe von</span></ComplCaption>
                        <ComplBody><span>...........</span></ComplBody>
                        <ComplTail><span>cm.</span></ComplTail>
                      </TextComplement>
                    </DetailTxt>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Fensterarbeiten (Textergänzungen des Bieters)</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item RNoPart="0080" ID="I-CO">
                <CONo>N1</CONo>
                <COStatus>Offered</COStatus>
                <Qty>5.000</Qty>
                <QU>m</QU>
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Nachtragsposition: zusätzliche Entwässerungsrinne</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Remark RNoPart="0060" ID="I-REMARK">
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Hinweis: Alle Mengen sind vor Ort zu prüfen.</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Remark>
              <!-- Zwei Hinweistexte ohne eigene Ordnungszahl: sie erben sonst die
                   Abschnitts-OZ und kollidieren miteinander. -->
              <Remark ID="I-REMARK-A">
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Hinweis ohne Ordnungszahl A</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Remark>
              <Remark ID="I-REMARK-B">
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Hinweis ohne Ordnungszahl B</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Remark>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
      </BoQBody>
    </BoQ>
  </Award>
</GAEB>
