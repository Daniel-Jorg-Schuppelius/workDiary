# WorkDiary — Container-ENV (MVP-720). Kopieren nach .env.docker und pflegen:
#   cp .env.docker.example .env.docker && chmod 600 .env.docker
# Die Datei wird von compose.yml als env_file in app/queue/scheduler/db geladen.
# Es gibt im Container KEINE .env-Datei — alles kommt aus dieser ENV; der
# Entrypoint baut daraus config:cache. Vollständige Schlüsselliste: .env.example.
# Handbuch: docs/on-premise-docker.md

# ── Anwendung ────────────────────────────────────────────────────────────
APP_NAME=WorkDiary
APP_ENV=production
APP_DEBUG=false
# Öffentliche URL inkl. Schema — hinter TLS-Proxy https://…
APP_URL=http://localhost:8080
# PFLICHT. Erzeugen: docker run --rm workdiary:local php artisan key:generate --show
# Sichern! Ohne den Schlüssel sind verschlüsselte Felder (PII, 2FA) verloren.
APP_KEY=
# Im Container ersetzt app:admin den Web-Installer (/install) → Marker per ENV.
APP_INSTALLED=true
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_DISPLAY_TIMEZONE=Europe/Berlin
# Zeitzone des Containers (OS-Ebene, z. B. Cron-/Log-Zeitstempel).
TZ=Europe/Berlin

# ── Logging (Container: alles nach stderr → docker logs) ─────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
# Toolkit-Logs (php-error-toolkit-Bridge) in denselben Kanal.
ERROR_TOOLKIT_LOG_CHANNEL=stderr

# ── Datenbank (Dienst „db", MariaDB 11) ───────────────────────────────────
# SQLite ist nur für Demo/Test geeignet (Single-Writer, keine Nebenläufigkeit
# von Web + Queue + Scheduler) — produktiv MariaDB/MySQL oder PostgreSQL.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=workdiary
DB_USERNAME=workdiary
DB_PASSWORD=change-me-db-password
# Gleiche Werte für den MariaDB-Container (legt DB + Benutzer beim ersten Start an).
MARIADB_DATABASE=workdiary
MARIADB_USER=workdiary
MARIADB_PASSWORD=change-me-db-password
MARIADB_ROOT_PASSWORD=change-me-root-password

# ── Sessions / Sicherheit ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true nur mit HTTPS (Reverse-Proxy mit TLS) — sonst kein Login möglich.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Reverse-Proxy-Adressen (IP/CIDR, Komma-Liste) oder '*': Ohne Eintrag ist
# Request::ip() die Proxy-IP (Rate-Limits, Security-Log, Geo). Im Compose-
# Netz ist REMOTE_ADDR die Adresse des nginx-Containers → Docker-Subnetz
# eintragen, z. B. 172.16.0.0/12; Details docs/on-premise-docker.md.
TRUSTED_PROXIES=
# CSP Stufe 1/2 — Default AN. ALPINE_CSP_BUILD muss zum Build-Arg des Images
# passen (Umschalten = neuer Image-Build, siehe vite.config.js).
CSP_SCRIPT_NONCE=true
ALPINE_CSP_BUILD=true
# /.well-known/security.txt — leer = 404.
SECURITY_TXT_CONTACT=
# Täglicher Quelltext-Integritätslauf; im unveränderlichen Image sinnvoll.
INTEGRITY_CHECK_ENABLED=true

# ── Queue / Cache / Broadcast ────────────────────────────────────────────
QUEUE_CONNECTION=database
# Muss über dem Worker-Timeout (compose.yml: --timeout=600) liegen.
DB_QUEUE_RETRY_AFTER=630
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Profil „redis" (docker compose --profile redis up -d):
#   CACHE_STORE=redis  QUEUE_CONNECTION=redis  SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="workdiary@example.com"
MAIL_FROM_NAME=WorkDiary

# ── Backup (docs/backup-restore.md, docs/on-premise-docker.md §Backup) ───
# Heartbeat-Token des externen Backup-Skripts (scripts/backup.sh):
#   docker compose exec app php artisan workdiary:backup:rotate-token
# schreibt ihn NICHT in diese Datei (keine .env im Container) — Wert hier
# eintragen und app/queue/scheduler neu starten.
BACKUP_HEARTBEAT_TOKEN=
# Verschlüsselte Cloud-Backupziele: 32 Byte base64, OFFLINE sichern.
#   php -r "echo base64_encode(random_bytes(32));"
BACKUP_MASTER_KEY=
BACKUP_RECOVERY_PUBLIC_KEY=

# ── Compose-Steuerung (nur compose.yml/Entrypoint, keine App-Schlüssel) ──
# 1 = Web-Dienst migriert beim Start (Erststart + Updates); 0 = manuell.
WD_AUTO_MIGRATE=0
# Veröffentlichter HTTP-Port des nginx-Dienstes (dahinter der TLS-Proxy).
WD_HTTP_PORT=8080
# Sekunden, die der Entrypoint auf die Datenbank wartet.
WD_DB_WAIT_SECONDS=60
